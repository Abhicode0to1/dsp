PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dsp

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Customer Panel SSO (domain-management-system integration). Shared only with
# that repo/app — deliberately separate from JWT_SECRET.
SSO_SHARED_SECRET=your_shared_sso_secret_same_value_in_both_apps

# Customer Panel server-to-server integration (Phase 2 — dashboard ticket count)
INTEGRATION_API_KEY=your_integration_api_key_same_value_in_both_apps
